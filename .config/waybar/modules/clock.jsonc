{
	"clock": {
		"interval": 1,
		"format": "{:%H:%M:%S}",
		"tooltip": true,
		"tooltip-format": "<tt><small>{calendar}</small></tt>",

		"calendar": {
			"mode": "year",
			"mode-mon-col": 3,
			"on-scroll": 1,
			"format": {
				"months": "<span color='#f26a8d'><b>{}</b></span>",
                "days": "<span color='#cbeef3'><b>{}</b></span>",
                "weekdays": "<span color='#dd2d4a'><b>{}</b></span>",
                "today": "<span color='#880d1e'><b><u>{}</u></b></span>"
                }
			},
		"actions": {
			"on-click": "shift_up",
			"on-click-right": "shift_down"
		}
		}
	}
}
