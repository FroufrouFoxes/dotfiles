{
	"pulseaudio": {
	    "format": "{volume}% {icon}",
	    "format-bluetooth": "{volume}% {icon}",
	    "format-muted": "0% 󰖁",
	    "format-icons": {
	        "headphone": "",
	        // order is low to high
	        "default": ["󰖀", "󰕾"]
	    },
	    "scroll-step": 1,
	    "on-click": "pavucontrol",
	    "ignored-sinks": ["Easy Effects Sink"],
	    "max-length": 8,
	    "min-length": 8
	},
	
	"pulseaudio/slider": {
		"min": 0,
		"max": 100,
		"orientation": "horizontal"
	}
}
